{
  "builds": [
    {
      "src": "luxestays_project/wsgi_vercel.py",
      "use": "@vercel/python",
      "config": {
        "requirements": "requirements-vercel-optimized.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "luxestays_project/wsgi_vercel.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "DJANGO_SETTINGS_MODULE": "luxestays_project.settings_vercel_optimized"
  }
} 